# Brewfile — packages and casks installed via Homebrew on a fresh Mac.
#
# Install everything in this file with:
#   brew bundle --file=configs/Brewfile
#
# IMPORTANT: this file is a CURATED list of what should be installed on a
# fresh setup, not a snapshot of what's currently on the machine. Do NOT
# regenerate it with `brew bundle dump --force` without cleaning up the
# current Mac first — that command re-adds every package it sees installed
# and would put back the per-project Python packages we removed
# (numpy, matplotlib, pillow, jupyterlab, etc.). Those belong inside venvs;
# see section 10 of the README.

# ─── Core dev tools ─────────────────────────────────────────────────────
brew "git"           # newer than the Xcode CLI tools version
brew "gh"            # GitHub CLI — `gh auth login`, `gh repo create`, etc.
brew "gcc"           # C/C++ compiler

# ─── Shell / terminal utilities ─────────────────────────────────────────
brew "fastfetch"   # actively-maintained replacement for the archived neofetch
brew "progress"      # show progress for long-running commands like cp/dd

# ─── Python ─────────────────────────────────────────────────────────────
# Just the interpreter — every project gets its own venv. See README §10.
brew "python"

# ─── GUI apps ───────────────────────────────────────────────────────────
cask "iterm2"
cask "visual-studio-code"

# ─── LaTeX ──────────────────────────────────────────────────────────────
# Full TeX Live without TeXShop, BibDesk and LaTeXiT (editing happens in
# VS Code). About 6 GB, and the installer asks for the admin password, so
# `brew bundle` stops and waits for it. Packages are updated with tlmgr; see
# README §11 before running `brew upgrade` when a new TeX Live year is out.
cask "mactex-no-gui"

# ─── Fonts ──────────────────────────────────────────────────────────────
cask "font-meslo-lg-nerd-font"   # MesloLGS NF, for the icons in the Powerlevel10k prompt

# ─── VS Code extensions ────────────────────────────────────────────────
# Not listed here. configs/vscode/extensions.txt is the one list, and
# configs/vscode/setup.sh installs from it (Settings Sync also restores them).
