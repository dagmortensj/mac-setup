# terminal.Brewfile: what the terminal look needs. Installed by
# `./install.sh terminal`, and the only Brewfile someone who just wants the
# look has to run.
#
# The Brewfiles are curated by hand. Never regenerate them with
# `brew bundle dump`: it writes every package on the machine into the file,
# dependencies included.

brew "git"                            # newer than the version in the Command Line Tools
brew "fastfetch"                      # system info and the Apple logo when a terminal opens

cask "iterm2"
cask "font-meslo-for-powerlevel10k"   # the MesloLGS NF font that iTerm2, VS Code and the prompt use
