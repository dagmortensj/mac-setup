# apps.Brewfile: personal apps. Installed by `./install.sh apps`.
# Edit this list before running it on your own Mac.
#
# Every one of these apps updates itself. Homebrew knows that and leaves them
# alone on a plain `brew upgrade`.

cask "claude"
cask "dropbox"
cask "microsoft-teams"
cask "google-chrome"
cask "discord"
cask "steam"
cask "qobuz"
cask "logi-options+"
