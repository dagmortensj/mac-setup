{
  "name": "host-theme",
  "displayName": "Høst",
  "description": "Høstlys og Høstkveld: lyst og mørkt tema i jordfarger, med fargepaletten fra lualatex-malene (rød, oransje, grønn, blå og plum) og rust i tillegg. Dekker hele grensesnittet, LaTeX, Python (med semantisk utheving fra Pylance), Markdown, BibTeX, JSON, YAML, skall og diff. Med knapp i statuslinjen for å bytte mellom lyst og mørkt.",
  "version": "3.3.1",
  "publisher": "dagmorten",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Høstlys",
        "uiTheme": "vs",
        "path": "./themes/hostlys-color-theme.json"
      },
      {
        "label": "Høstkveld",
        "uiTheme": "vs-dark",
        "path": "./themes/hostkveld-color-theme.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "latex.host.injection",
        "path": "./syntaxes/latex-host.injection.json",
        "injectTo": [
          "text.tex.latex"
        ]
      },
      {
        "scopeName": "latex.host.tikzenv.injection",
        "path": "./syntaxes/latex-host-tikzmiljo.injection.json",
        "injectTo": [
          "text.tex.latex"
        ]
      },
      {
        "scopeName": "latex.host.tikz.injection",
        "path": "./syntaxes/latex-host-tikz.injection.json",
        "injectTo": [
          "text.tex.latex"
        ]
      },
      {
        "scopeName": "latex.host.options.injection",
        "path": "./syntaxes/latex-host-opsjoner.injection.json",
        "injectTo": [
          "text.tex.latex"
        ]
      }
    ]
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ]
}
