{
  "name": "arbeidsflate",
  "displayName": "Arbeidsflate",
  "description": "Knapp i statuslinjen som bytter arbeidsflate (.code-workspace).",
  "version": "1.0.0",
  "publisher": "dagmorten",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "arbeidsflate.neste",
        "title": "Switch to Next",
        "category": "Workspace"
      },
      {
        "command": "arbeidsflate.bytt",
        "title": "Choose from List",
        "category": "Workspace"
      }
    ],
    "configuration": {
      "title": "Arbeidsflate",
      "properties": {
        "arbeidsflate.mappe": {
          "type": "string",
          "default": "${userHome}/Developer/mac-setup/configs/vscode/workspaces",
          "description": "Mappa med .code-workspace-filene knappen velger mellom."
        }
      }
    }
  }
}
