{
    // Profil for skriving i LaTeX: bare teksten, uten linjenummer, faner,
    // forslag og popups. Mappetreet står til venstre, og preamblen er foldet
    // sammen (tex-preambel). Profilen brukes bare i arbeidsflata skriving.

    // ===== Utseende =====
    "workbench.colorTheme": "Høstlys",
    "workbench.preferredLightColorTheme": "Høstlys",          // knappen nede til høyre bytter mellom disse
    "workbench.preferredDarkColorTheme": "Høstkveld",
    "window.autoDetectColorScheme": false,
    "window.zoomLevel": 1,                                    // hele grensesnittet 20 % større; skriftstørrelsene under er valgt ut fra det
    // Som i Default: ikonene øverst i venstrefanen, og tannhjulet (profilbytte)
    // og kontoknappen oppe til høyre i tittellinjen. Med "hidden" forsvinner de to.
    "workbench.activityBar.location": "top",
    "workbench.editor.showTabs": "none",                      // filnavnet står i tittellinjen
    "workbench.startupEditor": "none",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.tips.enabled": false,
    "workbench.layoutControl.enabled": false,
    "workbench.browser.showInTitleBar": false,
    "window.commandCenter": false,
    "window.title": "${dirty}${activeEditorShort}",            // bare filnavnet; arbeidsflata står på knappen nede til venstre
    "breadcrumbs.enabled": false,
    "extensions.ignoreRecommendations": true,
    "update.showReleaseNotes": false,
    // Statuslinjen står: der er knappen som bytter mellom Høstlys og Høstkveld.

    // ===== Dempet LaTeX =====
    // Kommandoer, \begin/\end, miljønavn, etiketter og referanser settes i
    // samme grå som klammene, uten fet skrift, så prosaen er det som står i
    // full kontrast. Matematikk, seksjonstitler og uthevet tekst er som i
    // temaet. Slett hele denne innstillingen for å få temaets vanlige farger.
    "editor.tokenColorCustomizations": {
        "[Høstlys]": {
            "textMateRules": [
                {
                    "scope": [
                        "keyword.control.preamble.latex",
                        "keyword.control.include.latex",
                        "storage.type.function.latex",
                        "keyword.other.item.latex",
                        "storage.type.function.tex",
                        "keyword.control.tex",
                        "keyword.control.catcode.tex",
                        "support.function.be.latex",
                        "support.function.section.latex",
                        "variable.parameter.function.latex",
                        "support.function.general.latex",
                        "support.function.general.tex",
                        "support.function.emph.latex",
                        "support.function.textbf.latex",
                        "support.function.textit.latex",
                        "support.function.texttt.latex",
                        "support.function.url.latex",
                        "support.function.footnote.latex",
                        "support.function.marginpar.latex",
                        "support.function.verb.latex",
                        "keyword.control.ref.latex",
                        "keyword.control.label.latex",
                        "keyword.control.cite.latex",
                        "constant.other.general.math.tex",
                        "constant.other.math.tex",
                        "support.function.textcolor.latex",
                        "support.function.textsubscript.latex",
                        "support.function.textsuperscript.latex",
                        "support.function.textsc.latex",
                        "support.function.textsf.latex",
                        "support.function.textrm.latex",
                        "support.function.underline.latex",
                        "meta.group.braces.latex support.function.be.latex",
                        "meta.parameter.newcommand.latex support.function.be.latex",
                        "meta.group.braces.latex variable.parameter.function.latex",
                        "meta.parameter.newcommand.latex variable.parameter.function.latex",
                        "meta.group.braces.latex meta.function.environment.general.latex support.function.be.latex",
                        "meta.group.braces.latex meta.function.environment.math.latex support.function.be.latex",
                        "meta.group.braces.latex meta.function.environment.list.latex support.function.be.latex",
                        "meta.group.braces.latex meta.function.environment.tabular.latex support.function.be.latex",
                        "meta.group.braces.latex meta.function.environment.frame.latex support.function.be.latex",
                        "meta.group.braces.latex meta.function.environment.latex.tikz support.function.be.latex",
                        "meta.parameter.newcommand.latex meta.function.environment.general.latex support.function.be.latex",
                        "meta.parameter.newcommand.latex meta.function.environment.math.latex support.function.be.latex",
                        "meta.parameter.newcommand.latex meta.function.environment.list.latex support.function.be.latex",
                        "meta.parameter.newcommand.latex meta.function.environment.tabular.latex support.function.be.latex",
                        "meta.parameter.newcommand.latex meta.function.environment.frame.latex support.function.be.latex",
                        "meta.parameter.newcommand.latex meta.function.environment.latex.tikz support.function.be.latex",
                        "meta.group.braces.latex meta.function.environment.general.latex variable.parameter.function.latex",
                        "meta.group.braces.latex meta.function.environment.math.latex variable.parameter.function.latex",
                        "meta.group.braces.latex meta.function.environment.list.latex variable.parameter.function.latex",
                        "meta.group.braces.latex meta.function.environment.tabular.latex variable.parameter.function.latex",
                        "meta.group.braces.latex meta.function.environment.frame.latex variable.parameter.function.latex",
                        "meta.group.braces.latex meta.function.environment.latex.tikz variable.parameter.function.latex",
                        "meta.parameter.newcommand.latex meta.function.environment.general.latex variable.parameter.function.latex",
                        "meta.parameter.newcommand.latex meta.function.environment.math.latex variable.parameter.function.latex",
                        "meta.parameter.newcommand.latex meta.function.environment.list.latex variable.parameter.function.latex",
                        "meta.parameter.newcommand.latex meta.function.environment.tabular.latex variable.parameter.function.latex",
                        "meta.parameter.newcommand.latex meta.function.environment.frame.latex variable.parameter.function.latex",
                        "meta.parameter.newcommand.latex meta.function.environment.latex.tikz variable.parameter.function.latex",
                        "variable.parameter.definition.label.latex",
                        "constant.other.reference.label.latex",
                        "constant.other.reference.citation.latex",
                        "support.class.latex",
                        "constant.other.citation.latex",
                        "markup.underline.link.latex",
                        "keyword.control.ref.latex punctuation.definition.keyword.latex",
                        "keyword.control.cite.latex punctuation.definition.keyword.latex",
                        "support.function.url.latex punctuation.definition.function.latex",
                        "support.function.siunitx.latex",
                        "support.function.mhchem.latex",
                        "meta.parameter.optional.latex variable.parameter.function.latex"
                    ],
                    "settings": { "foreground": "#796b5b", "fontStyle": "" }
                }
            ]
        },
        "[Høstkveld]": {
            "textMateRules": [
                {
                    "scope": [
                        "keyword.control.preamble.latex",
                        "keyword.control.include.latex",
                        "storage.type.function.latex",
                        "keyword.other.item.latex",
                        "storage.type.function.tex",
                        "keyword.control.tex",
                        "keyword.control.catcode.tex",
                        "support.function.be.latex",
                        "support.function.section.latex",
                        "variable.parameter.function.latex",
                        "support.function.general.latex",
                        "support.function.general.tex",
                        "support.function.emph.latex",
                        "support.function.textbf.latex",
                        "support.function.textit.latex",
                        "support.function.texttt.latex",
                        "support.function.url.latex",
                        "support.function.footnote.latex",
                        "support.function.marginpar.latex",
                        "support.function.verb.latex",
                        "keyword.control.ref.latex",
                        "keyword.control.label.latex",
                        "keyword.control.cite.latex",
                        "constant.other.general.math.tex",
                        "constant.other.math.tex",
                        "support.function.textcolor.latex",
                        "support.function.textsubscript.latex",
                        "support.function.textsuperscript.latex",
                        "support.function.textsc.latex",
                        "support.function.textsf.latex",
                        "support.function.textrm.latex",
                        "support.function.underline.latex",
                        "meta.group.braces.latex support.function.be.latex",
                        "meta.parameter.newcommand.latex support.function.be.latex",
                        "meta.group.braces.latex variable.parameter.function.latex",
                        "meta.parameter.newcommand.latex variable.parameter.function.latex",
                        "meta.group.braces.latex meta.function.environment.general.latex support.function.be.latex",
                        "meta.group.braces.latex meta.function.environment.math.latex support.function.be.latex",
                        "meta.group.braces.latex meta.function.environment.list.latex support.function.be.latex",
                        "meta.group.braces.latex meta.function.environment.tabular.latex support.function.be.latex",
                        "meta.group.braces.latex meta.function.environment.frame.latex support.function.be.latex",
                        "meta.group.braces.latex meta.function.environment.latex.tikz support.function.be.latex",
                        "meta.parameter.newcommand.latex meta.function.environment.general.latex support.function.be.latex",
                        "meta.parameter.newcommand.latex meta.function.environment.math.latex support.function.be.latex",
                        "meta.parameter.newcommand.latex meta.function.environment.list.latex support.function.be.latex",
                        "meta.parameter.newcommand.latex meta.function.environment.tabular.latex support.function.be.latex",
                        "meta.parameter.newcommand.latex meta.function.environment.frame.latex support.function.be.latex",
                        "meta.parameter.newcommand.latex meta.function.environment.latex.tikz support.function.be.latex",
                        "meta.group.braces.latex meta.function.environment.general.latex variable.parameter.function.latex",
                        "meta.group.braces.latex meta.function.environment.math.latex variable.parameter.function.latex",
                        "meta.group.braces.latex meta.function.environment.list.latex variable.parameter.function.latex",
                        "meta.group.braces.latex meta.function.environment.tabular.latex variable.parameter.function.latex",
                        "meta.group.braces.latex meta.function.environment.frame.latex variable.parameter.function.latex",
                        "meta.group.braces.latex meta.function.environment.latex.tikz variable.parameter.function.latex",
                        "meta.parameter.newcommand.latex meta.function.environment.general.latex variable.parameter.function.latex",
                        "meta.parameter.newcommand.latex meta.function.environment.math.latex variable.parameter.function.latex",
                        "meta.parameter.newcommand.latex meta.function.environment.list.latex variable.parameter.function.latex",
                        "meta.parameter.newcommand.latex meta.function.environment.tabular.latex variable.parameter.function.latex",
                        "meta.parameter.newcommand.latex meta.function.environment.frame.latex variable.parameter.function.latex",
                        "meta.parameter.newcommand.latex meta.function.environment.latex.tikz variable.parameter.function.latex",
                        "variable.parameter.definition.label.latex",
                        "constant.other.reference.label.latex",
                        "constant.other.reference.citation.latex",
                        "support.class.latex",
                        "constant.other.citation.latex",
                        "markup.underline.link.latex",
                        "keyword.control.ref.latex punctuation.definition.keyword.latex",
                        "keyword.control.cite.latex punctuation.definition.keyword.latex",
                        "support.function.url.latex punctuation.definition.function.latex",
                        "support.function.siunitx.latex",
                        "support.function.mhchem.latex",
                        "meta.parameter.optional.latex variable.parameter.function.latex"
