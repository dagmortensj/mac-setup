    // ===== Utforsker =====
    // Hjelpefilene fra LaTeX vises ikke i mappetreet. De ligger fortsatt på disken.
    // Ingen liste over åpne filer, og ingen git-farger eller merker på filnavnene.
    "files.exclude": {
        "**/*.aux": true,
        "**/*.bbl": true,
        "**/*.bcf": true,
        "**/*.blg": true,
        "**/*.fdb_latexmk": true,
        "**/*.fls": true,
        "**/*.log": true,
        "**/*.out": true,
        "**/*.run.xml": true,
        "**/*.synctex.gz": true,
        "**/*.toc": true
    },
    "explorer.openEditors.visible": 0,
    "explorer.compactFolders": false,                         // hver mappe på sin egen linje, ikke dikt/Tidsrom
    "explorer.decorations.badges": false,
    "explorer.decorations.colors": false,
    "git.decorations.enabled": false,
    "scm.diffDecorations": "none",

    // ===== Tekst =====
    "editor.fontFamily": "MesloLGS NF",
    "editor.fontSize": 13,                                    // 15,6 px på skjermen med zoomen over
    "editor.lineHeight": 1.7,
    "editor.wordWrap": "on",
    "editor.wrappingIndent": "none",
    "editor.padding.top": 24,
    "editor.cursorSurroundingLines": 6,                       // linja du skriver på, står aldri helt nederst
    "editor.detectIndentation": false,

    // ===== Ingenting i margen =====
    "editor.lineNumbers": "off",
    "editor.glyphMargin": false,
    "editor.showFoldingControls": "mouseover",                // foldepilene vises bare under pekeren
    "editor.minimap.enabled": false,
    "editor.stickyScroll.enabled": false,
    "editor.renderLineHighlight": "none",
    "editor.renderWhitespace": "none",
    "editor.guides.indentation": false,
    "editor.overviewRulerBorder": false,
    "editor.hideCursorInOverviewRuler": true,

    // ===== Ingen forslag eller autofullføring =====
    // Ctrl+Mellomrom henter fortsatt forslag når du ber om dem (\cite, \ref).
    "editor.quickSuggestions": {
        "other": "off",
        "comments": "off",
        "strings": "off"
    },
    "editor.suggestOnTriggerCharacters": false,
    "editor.wordBasedSuggestions": "off",
    "editor.parameterHints.enabled": false,
    "editor.inlineSuggest.enabled": false,
    "editor.snippetSuggestions": "none",
    "editor.acceptSuggestionOnEnter": "off",
    "editor.tabCompletion": "off",

    // ===== Ingen popups og ingen feilstreker =====
    // Stavekontrollen tegner sine egne prikker og er ikke berørt.
    "editor.hover.enabled": "off",
    "editor.lightbulb.enabled": "off",
    "editor.codeLens": false,
    "editor.inlayHints.enabled": "off",
    "editor.occurrencesHighlight": "off",
    "editor.selectionHighlight": false,
    // VS Code har ingen innstilling som slår av feilstrekene, så de gjøres gjennomsiktige.
    "workbench.colorCustomizations": {
        "editorError.foreground": "#00000000",
        "editorWarning.foreground": "#00000000",
        "editorInfo.foreground": "#00000000",
        "editorOverviewRuler.errorForeground": "#00000000",
        "editorOverviewRuler.warningForeground": "#00000000",
        "editorOverviewRuler.infoForeground": "#00000000"
    },
    "problems.decorations.enabled": false,
    "chat.disableAIFeatures": true,

    // ===== Terminal =====
    "terminal.integrated.fontFamily": "MesloLGS NF",
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.drawBoldTextInBrightColors": false,
    "terminal.integrated.minimumContrastRatio": 1,
    "terminal.integrated.tabs.enabled": false,
    "terminal.integrated.persistentSessionReviveProcess": "never",
    "terminal.integrated.initialHint": false,

    // ===== Sikkerhet (workspace trust av) =====
    "security.workspace.trust.enabled": false,
    "security.workspace.trust.startupPrompt": "never",
    "security.workspace.trust.untrustedFiles": "open",

    // ===== LaTeX Workshop =====
    "latex-workshop.latex.autoBuild.run": "never",                // Cmd+R bygger
    // Én oppskrift uten motorvalg: .latexmkrc i prosjektmappa bestemmer
    // (lualatex/pdflatex). Uten slik fil avgjør ~/.config/latexmk/latexmkrc.
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": ["-synctex=1", "-interaction=nonstopmode", "-file-line-error", "-outdir=%OUTDIR%", "%DOC%"],
            "env": {}
        }
    ],
    "latex-workshop.latex.recipes": [
        { "name": "latexmk", "tools": ["latexmk"] }
    ],
    "latex-workshop.latex.recipe.default": "first",
    "latex-workshop.view.pdf.viewer": "tab",                       // PDF i egen fane ...
    "latex-workshop.view.pdf.tab.editorGroup": "right",            // ... til høyre for koden
    "latex-workshop.synctex.afterBuild.enabled": true,
    "latex-workshop.view.outline.sync.viewer": true,
    "latex-workshop.message.error.show": false,
    "latex-workshop.message.warning.show": false,
    "latex-workshop.message.log.show": false,
    "workbench.editorAssociations": {
        "*.pdf": "latex-workshop-pdf-hook"
    },

    // ===== Stavekontroll: bare LaTeX og Markdown, norsk og engelsk =====
    // Et ord godtas hvis det finnes i en av ordbøkene. Ctrl+Cmd+S slår av/på.
    "cSpell.enabled": true,
    "cSpell.language": "nb,en",
    "cSpell.enabledFileTypes": {
        "*": false,
        "latex": true,
        "markdown": true
    },
    "cSpell.checkOnlyEnabledFileTypes": true,
    // Diskré prikket understreking i stedet for bølgestrek, og ikke i Problems-panelet
    "cSpell.diagnosticLevel": "Hint",
    "cSpell.useCustomDecorations": true,
    "cSpell.textDecorationLine": "underline",
    "cSpell.textDecorationStyle": "dotted",
    "cSpell.textDecorationColor": "#e08a2c",
    "cSpell.textDecorationThickness": "1.5px",
    "cSpell.showInRuler": false,                             // ingen merker i rullefeltet
    // Sammensatte ord godtas når delene finnes i ordboka (banefart, sirklingsfarten),
    // og ord med stor forbokstav (navn som Kepler, Rutherford) sjekkes ikke.
    "cSpell.allowCompoundWords": true,
    "cSpell.ignoreRegExpList": ["/(?<!\\p{L})\\p{Lu}\\p{L}+/gu"],
    // Egne ord ligger i mac-setup, så de følger med i git og overskrives ikke
    // når settings.json kopieres inn. Cmd+. på et ord → «Add to ordliste».
    "cSpell.customDictionaries": {
        "ordliste": {
            "name": "ordliste",
            "path": "${userHome}/Developer/mac-setup/configs/cspell/ordliste.txt",
            "addWords": true,
            "scope": "user"
        }
    },
    // Hopp over kommandoer, argumenter som er nøkler/filnavn, og all matematikk
    "cSpell.languageSettings": [
        {
            "languageId": "latex",
            "ignoreRegExpList": [
                "/\\\\(?:label|ref|eqref|autoref|cref|Cref|cite[pt]?|input|include|includegraphics|usepackage|RequirePackage|documentclass|begin|end|url|href|bibliography|bibliographystyle|addbibresource|graphicspath|newcommand|renewcommand|DeclareMathOperator|hypersetup|setmainfont|setmathfont|SI|si|qty|unit|usetikzlibrary|usephysicsmodule|tikzset|pgfplotsset|sisetup|captionsetup|newtheorem|theoremstyle|setlength|addtolength|hspace|vspace|geometry|color|textcolor|definecolor|pagestyle|thispagestyle)\\*?(?:\\[[^\\]]*\\])*\\{[^}]*\\}/g",
                "/\\\\[a-zA-Z@]+/g",
                "/\\\\[a-zA-Z@]+\\*?\\[[^\\]]*\\]/g",
                "/\\$[^$]*\\$/g",
                "/\\\\\\([\\s\\S]*?\\\\\\)/g",
                "/\\\\\\[[\\s\\S]*?\\\\\\]/g",
                "/\\\\begin\\{(equation|align|alignat|gather|multline|flalign|eqnarray|tikzpicture|lstlisting|verbatim|minted)\\*?\\}[\\s\\S]*?\\\\end\\{\\1\\*?\\}/g"
            ]
        }
    ],

    // ===== Annet =====
    "git.openRepositoryInParentFolders": "always",
    "window.restoreWindows": "one"
}
