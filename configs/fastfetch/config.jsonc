{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/eple.txt",
    "color": {
      "1": "red",
      "2": "cyan",
      "3": "yellow",
      "4": "green",
      "5": "blue",
      "6": "magenta"
    },
    "padding": {
      "right": 3
    }
  },
  "display": {
    "separator": ": ",
    "size": { "binaryPrefix": "jedec", "ndigits": 0 },   // "24 GB", not "24.00 GiB"
    "color": {
      "keys": "cyan"   // rust: a visual choice for the welcome screen, not a code role
    }
  },
  "modules": [
    { "type": "os",           "key": "OS" },
    { "type": "kernel",       "key": "Kernel" },
    { "type": "uptime",       "key": "Uptime" },
    { "type": "shell",        "key": "Shell" },
    { "type": "terminal",     "key": "Terminal" },
    { "type": "terminalfont", "key": "Terminal Font" },
    { "type": "cpu",          "key": "CPU" },
    { "type": "gpu",          "key": "GPU" },
    { "type": "memory",       "key": "Memory", "format": "{total}" },
    { "type": "disk",         "key": "Disk",   "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" },
    "break",
    { "type": "custom", "format": "{#40}   {#41}   {#46}   {#43}   {#42}   {#44}   {#45}   {#47}   {#}" },
    { "type": "custom", "format": "{#100}   {#101}   {#106}   {#103}   {#102}   {#104}   {#105}   {#107}   {#}" },
    "break",
    "break",
    "break"
  ]
}
